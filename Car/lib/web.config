<?xml version="1.0" encoding="UTF-8"?>
<!-- Libraries are only include()d by our PHP files; nothing here should be reachable by URL
     (e.g. phpqrcode/index.php demo writes files to disk for anyone). -->
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>
                <fileExtensions allowUnlisted="false" />
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
