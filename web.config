<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <add name="PHP_via_FastCGI" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\PHP\php-cgi.exe" resourceType="File"/>
            <add name="PHP_via_FastCGI_html" path="*.html" verb="*" modules="FastCgiModule" scriptProcessor="C:\PHP\php-cgi.exe" resourceType="File" requireAccess="Script" />
        </handlers>
        <rewrite>
            <rules>
                <rule name="RootToCar">
                    <match url="^$" />
                    <action type="Rewrite" url="Car/index.html" />
                </rule>
            </rules>
        </rewrite>

        <!-- 🚀 เพิ่มส่วนนี้: Kernel-Mode Caching สำหรับไฟล์ static และ html -->
        <!-- 🔒 เอา .html ออกจาก cache: .html ทุกหน้ารัน PHP (guard_user/guard_admin เช็ค login) ถ้า IIS cache ผลลัพธ์ไว้
             อาจเสิร์ฟหน้าที่ผ่าน guard แล้วให้คนที่ยังไม่ login หรือเสิร์ฟ redirect ค้างให้คนที่ login แล้ว -->
        <caching>
            <profiles>
                <add extension=".css" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
                <add extension=".js" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
            </profiles>
        </caching>

        <!-- 🔒 ไฟล์ที่ไม่ควรเปิดผ่าน URL ได้ (git, ตั้งค่า PHP, พิกัดจุดบริษัท, ไฟล์ apache ที่ IIS ไม่ใช้) -->
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment=".git" />
                    <add segment=".gitignore" />
                    <add segment=".user.ini" />
                    <add segment=".htaccess" />
                    <add segment="geo_sites.json" />
                    <add segment="cacert.pem" />
                </hiddenSegments>
            </requestFiltering>
        </security>

    </system.webServer>
</configuration>