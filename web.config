<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <add name="PHP_via_FastCGI" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\PHP\php-cgi.exe" resourceType="File"/>
            <add name="PHP_via_FastCGI_html" path="*.html" verb="*" modules="FastCgiModule" scriptProcessor="C:\PHP\php-cgi.exe" resourceType="File" requireAccess="Script" />
        </handlers>
        <rewrite>
            <rules>
                <!-- ===== URL สะอาด (ทำให้ไม่เห็น /Car/ และ .html) — ทุกกฎ stopProcessing กันวนซ้ำ ===== -->
                <rule name="RootToHome" stopProcessing="true">
                    <match url="^$" />
                    <action type="Rewrite" url="Car/homepage.html" />
                </rule>
                <rule name="OldHomepage" stopProcessing="true">
                    <match url="^(?:Car/)?homepage\.html$" />
                    <action type="Redirect" url="/" redirectType="Found" appendQueryString="true" />
                </rule>
                <rule name="Old_index" stopProcessing="true">
                    <match url="^(?:Car/)?index\.html$" />
                    <action type="Redirect" url="/login" redirectType="Found" appendQueryString="true" />
                </rule>
                <rule name="Old_booking" stopProcessing="true">
                    <match url="^(?:Car/)?booking\.html$" />
                    <action type="Redirect" url="/booking" redirectType="Found" appendQueryString="true" />
                </rule>
                <rule name="Old_car-status" stopProcessing="true">
                    <match url="^(?:Car/)?car\-status\.html$" />
                    <action type="Redirect" url="/queue" redirectType="Found" appendQueryString="true" />
                </rule>
                <rule name="Old_booking-details" stopProcessing="true">
                    <match url="^(?:Car/)?booking\-details\.html$" />
                    <action type="Redirect" url="/history" redirectType="Found" appendQueryString="true" />
                </rule>
                <rule name="Old_car-details" stopProcessing="true">
                    <match url="^(?:Car/)?car\-details\.html$" />
                    <action type="Redirect" url="/cars" redirectType="Found" appendQueryString="true" />
                </rule>
                <rule name="Old_checkin" stopProcessing="true">
                    <match url="^(?:Car/)?checkin\.html$" />
                    <action type="Redirect" url="/checkin" redirectType="Found" appendQueryString="true" />
                </rule>
                <rule name="Old_return_scan" stopProcessing="true">
                    <match url="^(?:Car/)?return_scan\.html$" />
                    <action type="Redirect" url="/return" redirectType="Found" appendQueryString="true" />
                </rule>
                <rule name="Old_profile" stopProcessing="true">
                    <match url="^(?:Car/)?profile\.html$" />
                    <action type="Redirect" url="/profile" redirectType="Found" appendQueryString="true" />
                </rule>
                <rule name="OldScan" stopProcessing="true">
                    <match url="^Car/scan\.php$" />
                    <action type="Redirect" url="/scan" redirectType="Found" appendQueryString="true" />
                </rule>
                <rule name="AdminShort" stopProcessing="true">
                    <match url="^(?:admin|Admin/index\.html)$" />
                    <action type="Redirect" url="/Admin/" redirectType="Found" appendQueryString="true" />
                </rule>
                <!-- /booking/ -> /booking (กัน relative link พัง), /booking.html -> /booking, /Car/ -> / -->
                <rule name="CleanTrailingSlash" stopProcessing="true">
                    <match url="^(login|booking|queue|history|cars|checkin|return|profile|scan|guard)/$" />
                    <action type="Redirect" url="/{R:1}" redirectType="Found" appendQueryString="true" />
                </rule>
                <rule name="CleanWithHtml" stopProcessing="true">
                    <match url="^(login|booking|queue|history|cars|checkin|return|profile|scan)\.html$" />
                    <action type="Redirect" url="/{R:1}" redirectType="Found" appendQueryString="true" />
                </rule>
                <rule name="CarRoot" stopProcessing="true">
                    <match url="^Car/?$" />
                    <action type="Redirect" url="/" redirectType="Found" appendQueryString="true" />
                </rule>
                <rule name="Clean_login" stopProcessing="true">
                    <match url="^login/?$" />
                    <action type="Rewrite" url="Car/index.html" />
                </rule>
                <rule name="Clean_booking" stopProcessing="true">
                    <match url="^booking/?$" />
                    <action type="Rewrite" url="Car/booking.html" />
                </rule>
                <rule name="Clean_queue" stopProcessing="true">
                    <match url="^queue/?$" />
                    <action type="Rewrite" url="Car/car-status.html" />
                </rule>
                <rule name="Clean_history" stopProcessing="true">
                    <match url="^history/?$" />
                    <action type="Rewrite" url="Car/booking-details.html" />
                </rule>
                <rule name="Clean_cars" stopProcessing="true">
                    <match url="^cars/?$" />
                    <action type="Rewrite" url="Car/car-details.html" />
                </rule>
                <rule name="Clean_checkin" stopProcessing="true">
                    <match url="^checkin/?$" />
                    <action type="Rewrite" url="Car/checkin.html" />
                </rule>
                <rule name="Clean_return" stopProcessing="true">
                    <match url="^return/?$" />
                    <action type="Rewrite" url="Car/return_scan.html" />
                </rule>
                <rule name="Clean_profile" stopProcessing="true">
                    <match url="^profile/?$" />
                    <action type="Rewrite" url="Car/profile.html" />
                </rule>
                <rule name="Old_guard" stopProcessing="true">
                    <match url="^(?:Car/)?guard\.html$" />
                    <action type="Redirect" url="/guard" redirectType="Found" appendQueryString="true" />
                </rule>
                <rule name="Clean_guard" stopProcessing="true">
                    <match url="^guard/?$" />
                    <action type="Rewrite" url="Car/guard.html" />
                </rule>
                <rule name="Clean_scan" stopProcessing="true">
                    <match url="^scan/?$" />
                    <action type="Rewrite" url="Car/scan.php" />
                </rule>
                <rule name="CarAssets" stopProcessing="true">
                    <match url="^(?!(?:Car|Admin|\.git)/)(?!.*\.\.)(.+\.(?:css|js|json|php|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|map)|assets/.+|uploads/.+)$" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="Car/{R:1}" />
                </rule>
            </rules>
        </rewrite>

        <!-- 🚀 เพิ่มส่วนนี้: Kernel-Mode Caching สำหรับไฟล์ static และ html -->
        <!-- 🔒 เอา .html ออกจาก cache: .html ทุกหน้ารัน PHP (guard_user/guard_admin เช็ค login) ถ้า IIS cache ผลลัพธ์ไว้
             อาจเสิร์ฟหน้าที่ผ่าน guard แล้วให้คนที่ยังไม่ login หรือเสิร์ฟ redirect ค้างให้คนที่ login แล้ว -->
        <caching>
            <profiles>
                <add extension=".css" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
                <add extension=".js" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
            </profiles>
        </caching>

        <!-- 🔒 ไฟล์ที่ไม่ควรเปิดผ่าน URL ได้ (git, ตั้งค่า PHP, พิกัดจุดบริษัท, ไฟล์ apache ที่ IIS ไม่ใช้) -->
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment=".git" />
                    <add segment=".gitignore" />
                    <add segment=".user.ini" />
                    <add segment=".htaccess" />
                    <add segment="geo_sites.json" />
                    <add segment="cacert.pem" />
                </hiddenSegments>
            </requestFiltering>
        </security>

    </system.webServer>
</configuration>